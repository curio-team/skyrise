{
  "name": "skyrise",
  "version": "0.1.0",
  "description": "A collaborative game where students work together to build a virtual city",
  "license": "MIT",
  "author": "curio-team",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy-files",
    "copy-files": "node -e \"require('fs').cpSync('src/config', 'dist/config', {recursive: true}); require('fs').cpSync('src/database/schema.sql', 'dist/database/schema.sql');\"",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "watch": "tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3"
  }
}
